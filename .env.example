# ============================================================
# Ling Chinese Lab — E-Book HSK Store Environment Variables
# Copy this to .env.local and fill in your credentials
# NEVER commit .env.local to git!
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Midtrans Frontend ─────────────────────────────────────────
# Found in: Midtrans Dashboard → Settings → Access Keys
# Use Sandbox Client Key for testing, Production Client Key for live
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
VITE_MIDTRANS_IS_PRODUCTION=false

# ── Supabase Edge Functions will use these (set in Supabase Dashboard) ──
# Dashboard → Project Settings → Edge Functions → Secrets
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
# MIDTRANS_IS_PRODUCTION=false
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected by Supabase)
